# Copie para .env e preencha com os dados do seu HostGator (cPanel > Contas de FTP).
# O arquivo .env NÃO é versionado (está no .gitignore).

FTP_HOST=ftp.solucoesemti.com.br
FTP_USER=usuario@solucoesemti.com.br
FTP_PASS=sua-senha-aqui

# Pasta de destino no servidor.
#  - subpasta do site:  public_html/spa-financas  -> solucoesemti.com.br/spa-financas
#  - raiz do domínio:   public_html               (CUIDADO: site principal)
#  - subdomínio:        public_html/spa-financas   (após criar o subdomínio no cPanel)
REMOTE_DIR=public_html/spa-financas

# Porta FTP (21 = FTP/FTPS explícito padrão do HostGator)
FTP_PORT=21
